{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/app/globals.css",
    "functions": ["cn", "clsx", "cva"]
  },
  "ignorePatterns": [
    "node_modules",
    ".next",
    "out",
    "allure-report",
    "allure-results",
    "pnpm-lock.yaml",
    "build",
    "coverage",
    "next-env.d.ts",
    "public/openapi.json"
  ],
  "sortImports": {
    "groups": [
      "side_effect",
      "builtin",
      "external",
      "internal",
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "internalPattern": ["@/"]
  }
}
